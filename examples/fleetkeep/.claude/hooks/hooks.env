# hooks.env — project-specific values sourced by every .claude/hooks/*.sh script.
#
# HOW THIS WORKS: each hook sources this file and SKIPS a check when its value is
# empty (or its *_CHECK flag is "off"). An un-customized template is therefore
# inert-safe — no hook blocks or warns until you opt in here.
#
# Filled for FleetKeep (multi-tenant fleet compliance SaaS — .NET 8 API + React SPA on Azure).
# Values are space-separated lists where noted. All shell-quoted.

# ── Version control ──────────────────────────────────────────────────────────
# Branches that may never be pushed to directly (space-separated).
# main = production; develop = the integration branch deployed to dev.
PROTECTED_BRANCHES="main develop"
# Allowed prefixes for working branches (space-separated, no slashes).
WORK_BRANCH_PREFIXES="feature fix chore hotfix"
# GitHub, so the gh CLI is available and a change request is a "pull request".
VCS_CLI="gh"                     # git | gh | glab
PR_TERM="pull request"           # "pull request" (GitHub/Bitbucket) | "merge request" (GitLab)

# ── Deploy guard (optional) ──────────────────────────────────────────────────
# Deploys run from GitHub Actions, never a developer machine — but `az deployment group
# create` still works locally if someone is signed in, so guard the production group by name.
DEPLOY_CMD="az deployment group create"
PROD_STAGE="rg-fleetkeep-prod"

# ── Repo layout ──────────────────────────────────────────────────────────────
# PACKAGE_DIRS drives the post-edit type-check/lint loop (post-tool-use.sh): for the
# FIRST listed dir that contains the edited file, the hook cd's there and runs
# TYPECHECK_CMD + LINT_CMD. Only the React app is listed, so the npm tooling below never
# runs on a .cs edit — a change under src/Api matches no package dir and runs nothing.
# The .NET side is verified by build instead (`dotnet build -warnaserror`), which is too
# slow to run on every keystroke-level edit.
PACKAGE_DIRS="src/Web"
# Optional named dirs used only by the domain checks below.
BACKEND_DIR="src/Api"
FRONTEND_DIR="src/Web"

# ── Quality commands (run after edits; blank ⇒ skip) ─────────────────────────
# These run ONLY inside PACKAGE_DIRS (= src/Web), so they apply to the Vite + React +
# TypeScript app and never to the .NET solutions.
TYPECHECK_CMD="npm run typecheck"
LINT_CMD="npx eslint"

# ── Sensitive-file guards (blank ⇒ off) ──────────────────────────────────────
# Generated EF Core migrations must not be hand-edited — regenerate them instead.
MIGRATIONS_GLOB="src/Api/FleetKeep.Infrastructure/Migrations/*"
MIGRATIONS_REGEN_CMD="dotnet ef migrations add <Name> --project src/Api/FleetKeep.Infrastructure"
# Files that carry secrets / are load-bearing config — WARN before editing.
SENSITIVE_CONFIG_GLOBS="*/appsettings*.json */local.settings.json infra/env/*.bicepparam .github/workflows/*.yml src/Web/.env*"

# ── Optional domain checks (off by default) ──────────────────────────────────
# ON. FleetKeep is shared-database, shared-schema multi-tenancy: isolation is a code
# invariant (the TenantId global query filter), not an infrastructure boundary, so a query
# that escapes it is a security bug. Warn when an edited backend file adds a query without
# a visible TenantId reference.
TENANT_ISOLATION_CHECK="on"      # on | off
TENANT_KEY="TenantId"

# Frontend env access: ON for the Vite app. Vite exposes build-time env only via
# import.meta.env.VITE_* — bare process.env.* does not exist in browser bundles.
FRONTEND_ENV_CHECK="on"          # on | off
FRONTEND_ENV_BAD_PATTERN="process\\.env\\."
FRONTEND_ENV_GOOD_HINT="import.meta.env.VITE_*"

# Design tokens: ON. Mantine generates CSS custom properties from src/Web/src/theme/theme.ts,
# so a raw hex in a component silently breaks dark mode. Warn on hex literals under the
# frontend dir, exempting the theme and global stylesheet that legitimately define them.
DESIGN_TOKEN_CHECK="on"          # on | off
DESIGN_TOKEN_DOC=".ai/standards/project/frontend/design/palette.md"
DESIGN_TOKEN_EXEMPT_GLOBS="src/Web/src/theme/* src/Web/src/styles/global.css"

# ── TDD nudge (off by default) ───────────────────────────────────────────────
# ON. Both stacks have real test runners (xUnit, Vitest) wired into CI, so the nudge is
# satisfiable: editing a source file with no matching test is worth a prompt.
TDD_CHECK="on"                   # on | off
TEST_FILE_PATTERNS="*.test.* *.spec.* *Tests.cs *Tests/*"
TDD_EXEMPT_GLOBS="*.md *.json *.yml *.yaml *.bicep *.bicepparam *.css *.config.* */Migrations/*"
