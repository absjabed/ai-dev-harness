# hooks.env — project-specific values sourced by every .claude/hooks/*.sh script.
#
# HOW THIS WORKS: each hook sources this file and SKIPS a check when its value is
# empty (or its *_CHECK flag is "off"). An un-customized template is therefore
# inert-safe — no hook blocks or warns until you opt in here.
#
# Filled for FleetKeep (multi-tenant fleet compliance SaaS — .NET 8 API + React SPA on Azure).
# Values are space-separated lists where noted. All shell-quoted.

# ── Version control ──────────────────────────────────────────────────────────
# Branches that may never be pushed to directly (space-separated).
# main = production; develop = the integration branch deployed to dev.
PROTECTED_BRANCHES="main develop"
# Allowed prefixes for working branches (space-separated, no slashes).
WORK_BRANCH_PREFIXES="feature fix chore hotfix"
# GitHub, so the gh CLI is available and a change request is a "pull request".
VCS_CLI="gh"                     # git | gh | glab
PR_TERM="pull request"           # "pull request" (GitHub/Bitbucket) | "merge request" (GitLab)

# ── Deploy guard (optional) ──────────────────────────────────────────────────
# Deploys run from GitHub Actions, never a developer machine — but `az deployment group
# create` still works locally if someone is signed in, so guard the production group by name.
DEPLOY_CMD="az deployment group create"
PROD_STAGE="rg-fleetkeep-prod"

# ── Repo layout ──────────────────────────────────────────────────────────────
# PACKAGE_DIRS drives the post-edit type-check/lint loop (post-tool-use.sh): for the
# FIRST listed dir that contains the edited file, the hook cd's there and runs
# TYPECHECK_CMD + LINT_CMD. Only the React app is listed, so the npm tooling below never
# runs on a .cs edit — a change under src/Api matches no package dir and runs nothing.
# The .NET side is verified by build instead (`dotnet build -warnaserror`), which is too
# slow to run on every keystroke-level edit.
PACKAGE_DIRS="src/Web"
# Optional named dirs used only by the domain checks below.
BACKEND_DIR="src/Api"
FRONTEND_DIR="src/Web"

# ── Quality commands (run after edits; blank ⇒ skip) ─────────────────────────
# These run ONLY inside PACKAGE_DIRS (= src/Web), so they apply to the Vite + React +
# TypeScript app and never to the .NET solutions.
TYPECHECK_CMD="npm run typecheck"
LINT_CMD="npx eslint"

# ── Sensitive-file guards (blank ⇒ off) ──────────────────────────────────────
# Generated EF Core migrations must not be hand-edited — regenerate them instead.
MIGRATIONS_GLOB="src/Api/FleetKeep.Infrastructure/Migrations/*"
MIGRATIONS_REGEN_CMD="dotnet ef migrations add <Name> --project src/Api/FleetKeep.Infrastructure"
# Files that carry secrets / are load-bearing config — WARN before editing.
# The last three are the quality gate's own config: an edit to a threshold or a lint rule is flagged.
SENSITIVE_CONFIG_GLOBS="*/appsettings*.json */local.settings.json infra/env/*.bicepparam .github/workflows/*.yml src/Web/.env* */eslint.config.* */vitest.config.* */stryker-config.json"

# ── Optional domain checks (off by default) ──────────────────────────────────
# ON. FleetKeep is shared-database, shared-schema multi-tenancy: isolation is a code
# invariant (the TenantId global query filter), not an infrastructure boundary, so a query
# that escapes it is a security bug. Warn when an edited backend file adds a query without
# a visible TenantId reference.
TENANT_ISOLATION_CHECK="on"      # on | off
TENANT_KEY="TenantId"

# Frontend env access: ON for the Vite app. Vite exposes build-time env only via
# import.meta.env.VITE_* — bare process.env.* does not exist in browser bundles.
FRONTEND_ENV_CHECK="on"          # on | off
FRONTEND_ENV_BAD_PATTERN="process\\.env\\."
FRONTEND_ENV_GOOD_HINT="import.meta.env.VITE_*"

# Design tokens: ON. Mantine generates CSS custom properties from src/Web/src/theme/theme.ts,
# so a raw hex in a component silently breaks dark mode. Warn on hex literals under the
# frontend dir, exempting the theme and global stylesheet that legitimately define them.
DESIGN_TOKEN_CHECK="on"          # on | off
DESIGN_TOKEN_DOC=".ai/standards/project/frontend/design/palette.md"
DESIGN_TOKEN_EXEMPT_GLOBS="src/Web/src/theme/* src/Web/src/styles/global.css"

# ── TDD nudge (off by default) ───────────────────────────────────────────────
# ON. Both stacks have real test runners (xUnit, Vitest) wired into CI, so the nudge is
# satisfiable: editing a source file with no matching test is worth a prompt.
TDD_CHECK="on"                   # on | off
TEST_FILE_PATTERNS="*.test.* *.spec.* *Tests.cs *Tests/*"
TDD_EXEMPT_GLOBS="*.md *.json *.yml *.yaml *.bicep *.bicepparam *.css *.config.* */Migrations/*"

# ── Quality gate (blank ⇒ that check is skipped) ─────────────────────────────
# .claude/scripts/quality-gate.sh runs these at the workflows' verify steps, from the repo root.
# The build covers both stacks: the .NET build is the C# type-check (-warnaserror, analyzers
# on), and TYPECHECK_CMD/LINT_CMD above cover src/Web. Tests write coverage for both: coverlet
# Cobertura for xUnit, lcov for Vitest.
# The gate keeps the base commit's stricter limits, suppression settings and file lists, so a
# change cannot loosen those for itself (a new exemption counts once merged); any other change
# to the gate is listed on gate-config.
GATE_BUILD_CMD="dotnet build -warnaserror && (cd src/Web && npm run build)"
# coverlet writes a new <guid>/ folder per run; the gate only reads reports this run wrote.
GATE_TEST_CMD="dotnet test --collect:'XPlat Code Coverage' && (cd src/Web && npx vitest run --coverage --coverage.reporter=lcov)"
SOURCE_GLOBS="*.cs *.ts *.tsx"
COVERAGE_REPORTS="**/TestResults/*/coverage.cobertura.xml src/Web/coverage/lcov.info"
COVERAGE_MIN="80"                # matches the 80% business-logic target in qa-agent.md
# Composition roots and generated EF Core migrations: no unit test reaches them.
COVERAGE_EXEMPT_GLOBS="*/Program.cs */Migrations/* src/Web/src/main.tsx"
COMPLEXITY_MAX="15"
CRAP_MAX="30"
# Stryker.NET mutates only the changed files (one -m per file, relative to the project, hence
# {name}). Not --since:{base}: the workflow's own .ai/ docs change too, which makes it test every
# mutant. Local tool: dotnet-tools.json + `dotnet tool restore`. Opt-in run: --mutation.
MUTATION_CMD="dotnet stryker {each:-m **/{name}} --break-at 70"
MUTATION_GLOBS="*.cs"            # Stryker.NET mutates C# only: .ts/.tsx changes never reach it

# ── Suppression guard (off by default) ───────────────────────────────────────
# WARN. Lists every #pragma warning disable, [ExcludeFromCodeCoverage], eslint-disable, skipped
# xUnit fact or Vitest it.skip the change adds, for the reviewer to judge.
SUPPRESSION_CHECK="warn"         # off | warn | block
SUPPRESSION_PATTERNS='eslint-disable|@ts-(ignore|nocheck|expect-error)|# *noqa|# *type: *ignore|pragma: *no cover|(istanbul|c8|v8) ignore|ExcludeFromCodeCoverage|#pragma warning disable|SuppressMessage|@SuppressWarnings|//nolint|NOSONAR|rubocop:disable|\b(it|test|describe)\.(skip|only)\(|\bx(it|describe)\(|pytest\.mark\.skip|\[Ignore\]|Skip *= *"|@Disabled|pytest\.(skip|xfail|importorskip)\(|pytest\.mark\.xfail|unittest\.skip|\.skipTest\(|\bSkipTest\b|(\b(t|b|tb)|\.T\(\))\.(Skip(f)?\(([[:space:]]*["`]|\)|fmt\.)|SkipNow\(\))|@Ignore\b|\[([^]]*[ ,])?Ignore\([[:space:]]*"|\[[^]]*Test[A-Za-z]*[[:space:]]*,[[:space:]]*Ignore\]|^[[:space:]]*x(it|describe|context|specify|test)[[:space:]]*(\(|["'\''`{]|do([[:space:]]|$))|^[[:space:]]*(skip|pending)[[:space:]]*(\([[:space:]]*)?["'\''`]|\b(it|test|describe|suite|context)(\.[a-z]+)*\.(skip|only|skipIf|runIf|todo|fails)\b|(^|[[:space:];(])f(it|describe)\([[:space:]]*["'\''`]|^[[:space:]]*f(it|describe|context)[[:space:]]+["'\''`]|#\[ignore\b|#!?\[allow\(|pylint: *disable|(ruff|flake8): *noqa|mypy: *ignore-errors|pyright: *ignore|@(file:)?Suppress[A-Za-z]*\(|NOLINT|biome-ignore|swiftlint:disable|phpcs:(ignore|disable)|@phpstan-ignore|markTest(Skipped|Incomplete)\(|XCTSkip|ReSharper disable|@Test\([^)]*enabled *= *false|@(unittest\.)?expectedFailure|^[[:space:]]*@skip(If|Unless)?\(|@codeCoverageIgnore|LCOV_EXCL_|GTEST_SKIP\(|TEST(_F|_P)?\(([^,]*,[[:space:]]*)?DISABLED_|deno-lint-ignore|stylelint-disable'
# Extended regex for test-case and assertion lines. With SUPPRESSION_CHECK on, the gate lists each
# one the change removes from a test file, or changes, without re-adding it. Trim or extend for your stack.
TEST_ASSERTION_PATTERNS='\[(Fact|Theory|Test|TestCase|TestMethod|DataRow|InlineData)\b|\b(it|test|describe)(\.each)?\(|\bit +"|\bdef test|@(Test|ParameterizedTest)\b|\bfunc Test|\b[Aa]ssert|\bexpect\(|\.[Ss]hould|\bverify\(|\bt\.(Error|Fatal)|pytest\.param\(|^[[:space:]]*\)?\.(not\.)?(to(Be|Equal|StrictEqual|Have|Contain|Match|Throw|Satisfy|Pass|Return|Resolve|Reject)[A-Za-z]*|resolves|rejects)\b'

# ── Runtime verification guard (blank ⇒ off) ─────────────────────────────────
# ON. Production resource hosts all carry "fleetkeep-prod" (<abbr>-fleetkeep-prod), and the SPA's
# production custom domain is app.fleetkeep.io — blocking both keeps the agent's API calls and
# browser checks on local and dev. Post-deploy production checks are done by a human or CI.
E2E_FORBIDDEN_HOSTS="fleetkeep-prod app.fleetkeep.io"
