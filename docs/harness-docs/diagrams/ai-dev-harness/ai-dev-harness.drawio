        <mxCell id="p11c41" value="&lt;b&gt;Commit&lt;/b&gt; on feature/&amp;lt;slug&amp;gt;, never the default branch&lt;br&gt;template release: bump HARNESS_VERSION and the&lt;br&gt;index.html sidebar, tag v&amp;lt;version&amp;gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p11c1">
