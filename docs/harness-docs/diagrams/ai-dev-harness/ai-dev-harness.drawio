  </diagram>
  <diagram id="page5" name="5 Epic Path">
    <mxGraphModel dx="1700" dy="2640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2640" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="p5c0" />
        <mxCell id="p5c1" parent="p5c0" />
        <mxCell id="p5c2" value="Epic path — Phases A–F, one worktree per sub-feature" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5c3" value="When epic-breakdown.md exists, /workflows:feature runs &lt;b&gt;six phases&lt;/b&gt;. Sub-features in one &lt;b&gt;dependency group&lt;/b&gt; are built in parallel, each by a developer sub-agent in its own git worktree, then merged into &lt;b&gt;epic/&amp;lt;slug&amp;gt;&lt;/b&gt; one by one before a single review and PR." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="40" y="60" width="1620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5c4" value="Epic: epic-breakdown.md exists" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="440" y="120" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p5c5" value="&lt;b&gt;Phase A — Validate inputs&lt;/b&gt;&lt;br&gt;read epic-breakdown.md: sub-features (slug, scope,&lt;br&gt;dependencies) and the dependency groups" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="210" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p5c7" value="&lt;b&gt;every sub-feature&lt;/b&gt;&lt;br&gt;has its three specs?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="480" y="330" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5c9" value="&lt;b&gt;STOP — specs missing&lt;/b&gt;&lt;br&gt;run /ba and /qa first" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="40" y="340" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5c11" value="&lt;b&gt;A4 · STOP — confirm the plan&lt;/b&gt;&lt;br&gt;sub-features and dependency groups" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="380" y="470" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5c13" value="&lt;b&gt;Phase B — UI/UX design gate&lt;/b&gt;&lt;br&gt;each UI sub-feature: /agents:design and its&lt;br&gt;approval loop, finished before Phase D" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="580" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p5c15" value="&amp;lt;sub&amp;gt;/design/design-spec.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="860" y="600" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p5c17" value="&lt;b&gt;Phase C — Create the epic branch&lt;/b&gt;&lt;br&gt;epic/&amp;lt;slug&amp;gt; from base · commit .ai/features/&amp;lt;slug&amp;gt;/&lt;br&gt;planning artifacts · push" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="700" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p5c19" value="&lt;b&gt;Phase D — per dependency group&lt;/b&gt;&lt;br&gt;.worktrees/ in .gitignore · one worktree each:&lt;br&gt;git worktree add -b feature/&amp;lt;slug&amp;gt;/&amp;lt;sub&amp;gt;&lt;br&gt;.worktrees/&amp;lt;sub&amp;gt; epic/&amp;lt;slug&amp;gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="820" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5c21" value="&lt;b&gt;∥ parallel&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f7f2fa;strokeColor=#9673a6;fontColor=#333333;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="230" y="940" width="740" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p5c22" value="&lt;b&gt;developer&lt;/b&gt; · sub-feature 1&lt;br&gt;works in .worktrees/&amp;lt;sub&amp;gt;&lt;br&gt;tech spec → code → tests&lt;br&gt;gate --base epic/&amp;lt;slug&amp;gt;&lt;br&gt;test-report · deploy-notes&lt;br&gt;commits feat(&amp;lt;sub&amp;gt;)" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="250" y="990" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5c24" value="&lt;b&gt;developer&lt;/b&gt; · sub-feature 2&lt;br&gt;works in .worktrees/&amp;lt;sub&amp;gt;&lt;br&gt;tech spec → code → tests&lt;br&gt;gate --base epic/&amp;lt;slug&amp;gt;&lt;br&gt;test-report · deploy-notes&lt;br&gt;commits feat(&amp;lt;sub&amp;gt;)" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="490" y="990" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5c26" value="&lt;b&gt;… one developer&lt;/b&gt;&lt;br&gt;per sub-feature in the&lt;br&gt;group, all at once" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="730" y="990" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5c28" value="Wait for the whole group to finish · update STATE.md" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="1160" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p5c33" value="&lt;b&gt;Phase E — Sequential merge&lt;/b&gt;, in dependency order&lt;br&gt;merge each sub-feature branch into epic/&amp;lt;slug&amp;gt;&lt;br&gt;resolve conflicts · re-verify · git worktree remove" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="1260" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p5c35" value="&lt;b&gt;Integrated gate&lt;/b&gt; — after git worktree prune&lt;br&gt;quality-gate.sh --base &amp;lt;base-branch&amp;gt;, no --mutation" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="1380" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p5c37" value="test-specs/quality-gate.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="860" y="1394" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p5c39" value="&lt;b&gt;gate FAIL, or a&lt;/b&gt;&lt;br&gt;&lt;b&gt;sub-feature failing?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="470" y="1490" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5c41" value="&lt;b&gt;STOP — your call&lt;/b&gt;&lt;br&gt;direct the fix, or accept&lt;br&gt;each failure" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="40" y="1495" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5c43" value="&lt;b&gt;Phase F — Final review&lt;/b&gt; — both on the full epic diff" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="1630" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p5c45" value="&lt;b&gt;∥ parallel&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f7f2fa;strokeColor=#9673a6;fontColor=#333333;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="340" y="1724" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p5c46" value="&lt;b&gt;reviewer&lt;/b&gt;&lt;br&gt;haiku · read-only&lt;br&gt;BLOCKER · WARNING ·&lt;br&gt;SUGGESTION · PRAISE&lt;br&gt;→ review-report.md" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="360" y="1774" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5c48" value="&lt;b&gt;security-scanner&lt;/b&gt;&lt;br&gt;sonnet · writes its report only&lt;br&gt;CRITICAL · HIGH · MEDIUM · LOW&lt;br&gt;→ security-report.md" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="610" y="1774" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5c50" value="&lt;b&gt;0a · Runtime verification, once&lt;/b&gt; — page 8&lt;br&gt;on the integrated epic/&amp;lt;slug&amp;gt; branch, covering&lt;br&gt;every sub-feature's journeys" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="1924" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p5c53" value="test-specs/e2e-report.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="860" y="1944" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p5c55" value="&lt;b&gt;0b · Final gate&lt;/b&gt; — re-run if fixes changed the code" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="2040" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p5c57" value="&lt;b&gt;1 · PR description&lt;/b&gt; — sub-features, tests, gaps" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="2140" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p5c59" value="pr-description.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="860" y="2149" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p5c61" value="&lt;b&gt;2 · STOP — confirm the PR&lt;/b&gt;&lt;br&gt;CRITICAL findings resolved first&lt;br&gt;FAIL / NOT RUN only if accepted" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="380" y="2240" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5c63" value="&lt;b&gt;3 · Create the PR&lt;/b&gt; epic/&amp;lt;slug&amp;gt; → base branch&lt;br&gt;after committing .claude/agent-memory/" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="400" y="2370" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p5c65" value="Done — STATE.md: epic complete" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="440" y="2480" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p5c67" value="&lt;b&gt;Epic STATE.md&lt;/b&gt; (main working tree)&lt;br&gt;one ## Tasks line per sub-feature with its group:&lt;br&gt;pending → in progress → implemented → merged&lt;br&gt;the parent updates it per phase, group and merge;&lt;br&gt;spawned agents never edit it" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="1280" y="120" width="380" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p5c68" value="&lt;b&gt;Worktrees see committed files only&lt;/b&gt;&lt;br&gt;so Phase C commits the planning artifacts. Each&lt;br&gt;agent commits its specs, test report and deploy&lt;br&gt;notes on its branch; the worktree goes after merge." style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="1280" y="236" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5c69" value="&lt;b&gt;Crashed-run recovery&lt;/b&gt;&lt;br&gt;reuse a worktree only if it is valid and clean&lt;br&gt;branch but no folder: prune, attach without -b&lt;br&gt;never delete or -B a sub-feature branch&lt;br&gt;in doubt: STOP and ask" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="1280" y="336" width="380" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p5c70" value="&lt;b&gt;Where quality-gate.sh runs&lt;/b&gt;&lt;br&gt;Phase D: each agent, --base epic/&amp;lt;slug&amp;gt;,&lt;br&gt;--mutation on its last run&lt;br&gt;Phase E: once on the integrated branch&lt;br&gt;Phase F 0b: again if fixes changed code" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="1280" y="452" width="380" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p5c71" value="&lt;b&gt;Hard rules&lt;/b&gt;&lt;br&gt;no Phase D before the Phase A approval&lt;br&gt;no PR without approval of its description&lt;br&gt;never force-remove a dirty worktree: STOP, ask" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p5c1">
          <mxGeometry x="1280" y="568" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p5c72" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start / end · blue = step in your session · yellow diamond = decision · red hexagon = STOP · purple = sub-agent · orange = file written · green = rule · red box = hard rule · dashed = writes a file" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p5c1">
          <mxGeometry x="40" y="2580" width="1620" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p5c6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p5c1" source="p5c4" target="p5c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5c8" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p5c1" source="p5c5" target="p5c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5c10" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p5c1" source="p5c7" target="p5c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5c12" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p5c1" source="p5c7" target="p5c11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5c14" value="approved" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p5c1" source="p5c11" target="p5c13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5c16" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#888888;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p5c1" source="p5c13" target="p5c15">
