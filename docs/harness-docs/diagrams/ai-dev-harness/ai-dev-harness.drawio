        </mxCell>
        <mxCell id="p4c49" value="&lt;b&gt;security-scanner&lt;/b&gt;&lt;br&gt;sonnet · writes its report only&lt;br&gt;CRITICAL · HIGH · MEDIUM · LOW&lt;br&gt;→ security-report.md" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p4c1">
