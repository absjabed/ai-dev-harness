  <diagram id="page11" name="11 Self Improvement">
    <mxGraphModel dx="1700" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1700" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="p11c0" />
        <mxCell id="p11c1" parent="p11c0" />
        <mxCell id="p11c2" value="Self-improvement — /harness:improve" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p11c1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p11c3" value="Changes to the harness itself go through &lt;b&gt;.ai/workflows/harness-improvement.md&lt;/b&gt;: plan disjoint work packages, then per package an &lt;b&gt;author → critic → revise → recheck&lt;/b&gt; loop, one integration audit, and a final &lt;b&gt;STOP&lt;/b&gt; before anything lands. The critic checks the invariants on the right." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p11c1">
          <mxGeometry x="40" y="60" width="1620" height="40" as="geometry" />
        </mxCell>
