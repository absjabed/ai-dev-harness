        <mxCell id="p2c2" value="Agent pattern — command, persona, sub-agent" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p2c1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2c3" value="Each row is one persona. A &lt;b&gt;command&lt;/b&gt; (blue) @-includes the &lt;b&gt;persona&lt;/b&gt; (green) where the behaviour lives; a &lt;b&gt;sub-agent&lt;/b&gt; (purple), where one exists, loads the same persona into a fresh context. Commands and sub-agents add scope, tools and the task, never their own rules." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p2c1">
          <mxGeometry x="40" y="60" width="1620" height="40" as="geometry" />
        </mxCell>
