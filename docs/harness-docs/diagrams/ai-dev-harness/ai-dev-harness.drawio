        <mxCell id="p1c2" value="Architecture — knowledge layer vs execution layer" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p1c1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1c3" value="Read top to bottom: &lt;b&gt;you&lt;/b&gt; type a command in a &lt;b&gt;Claude Code session&lt;/b&gt;, which runs the &lt;b&gt;.claude/&lt;/b&gt; execution layer; that layer &lt;b&gt;@-includes&lt;/b&gt; the Markdown in &lt;b&gt;.ai/&lt;/b&gt; and writes its artifacts back there. Grey boxes along the bottom are &lt;b&gt;outside the harness&lt;/b&gt;." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p1c1">
          <mxGeometry x="40" y="60" width="1620" height="40" as="geometry" />
        </mxCell>
