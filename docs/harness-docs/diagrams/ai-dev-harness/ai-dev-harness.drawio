        <mxCell id="p4c46" value="&lt;b&gt;∥ parallel&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f7f2fa;strokeColor=#9673a6;fontColor=#333333;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p4c1">
