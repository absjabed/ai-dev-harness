          <mxGeometry x="440" y="120" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4c5" value="&lt;b&gt;Step 0&lt;/b&gt;&lt;br&gt;STATE.md exists?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p4c1">
          <mxGeometry x="490" y="210" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4c7" value="&lt;b&gt;Resume&lt;/b&gt; — trust but verify&lt;br&gt;check each done phase's artifact on disk&lt;br&gt;re-run any phase whose file is missing&lt;br&gt;continue from ## Next action" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p4c1">
