        </mxCell>
        <mxCell id="p4c42" value="&lt;b&gt;STOP — gate failed&lt;/b&gt;&lt;br&gt;go on only on your direction&lt;br&gt;or each failure accepted" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p4c1">
