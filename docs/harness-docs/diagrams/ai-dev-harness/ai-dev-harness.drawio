        <mxCell id="p3c48" value='&lt;b&gt;/workflows:hotfix "&amp;lt;issue&amp;gt;"&lt;/b&gt;&lt;br&gt;minimal fix from the default branch&lt;br&gt;review + smoke check · PR&lt;br&gt;writes deploy-notes.md' style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p3c1">
