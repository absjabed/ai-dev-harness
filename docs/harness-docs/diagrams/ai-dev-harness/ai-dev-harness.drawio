        </mxCell>
        <mxCell id="p4c3" value="Read down the spine. &lt;b&gt;Decisions&lt;/b&gt; branch right, &lt;b&gt;STOP exits&lt;/b&gt; go left, and orange notes are the files each step writes under .ai/features/&amp;lt;slug&amp;gt;/. Sub-agents (purple) only implement or review; every gate stays in your session." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p4c1">
          <mxGeometry x="40" y="60" width="1620" height="40" as="geometry" />
        </mxCell>
