        </mxCell>
        <mxCell id="p4c9" value="&lt;b&gt;Step 1&lt;/b&gt;&lt;br&gt;BA/QA inputs present?&lt;br&gt;&lt;font style='font-size:10px'&gt;requirement-spec ·&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;user-stories · test-specs&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p4c1">
          <mxGeometry x="450" y="350" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4c11" value="&lt;b&gt;STOP — inputs missing&lt;/b&gt;&lt;br&gt;run /ba &amp;lt;slug&amp;gt; and&lt;br&gt;/qa &amp;lt;slug&amp;gt; first" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p4c1">
