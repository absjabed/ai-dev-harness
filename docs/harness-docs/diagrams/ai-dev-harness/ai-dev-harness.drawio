  <diagram id="page6" name="6 Bug Fix">
    <mxGraphModel dx="1700" dy="1990" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1990" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="p6c0" />
        <mxCell id="p6c1" parent="p6c0" />
        <mxCell id="p6c2" value="Bug fix — /workflows:bugfix" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6c3" value="Fix causes, not symptoms. The spine follows &lt;b&gt;.ai/workflows/bug-fixing.md&lt;/b&gt;: guard the fix, verify with the quality gate, record deploy notes, then a &lt;b&gt;reviewer&lt;/b&gt; sub-agent and runtime checks of the original bug before the commit." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="40" y="60" width="1620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6c4" value='/workflows:bugfix "&amp;lt;symptom&amp;gt;"' style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="440" y="120" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6c5" value="&lt;b&gt;1 · Reproduce&lt;/b&gt;&lt;br&gt;capture the exact inputs, wrong vs expected" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="210" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p6c7" value="&lt;b&gt;2 · Find the root cause&lt;/b&gt;&lt;br&gt;trace it through the scope's layering; no symptom patch" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="320" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p6c9" value="&lt;b&gt;3 · Guard the fix&lt;/b&gt;&lt;br&gt;a failing test where the scope has a test runner,&lt;br&gt;a re-runnable manual reproduction where it has none" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="430" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p6c11" value="&lt;b&gt;4 · Fix&lt;/b&gt; — the minimal change at the root cause" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="550" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p6c13" value="&lt;b&gt;5 · Verify&lt;/b&gt;&lt;br&gt;quality-gate.sh --base &amp;lt;start branch&amp;gt;, no --mutation&lt;br&gt;gate loop: fix the cause, at most 3 failing runs" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="650" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p6c15" value="&lt;b&gt;still FAIL?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="510" y="770" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6c17" value="&lt;b&gt;STOP — gate still fails&lt;/b&gt;&lt;br&gt;show the user before review" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="40" y="770" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6c19" value="&lt;b&gt;6 · Assess blast radius&lt;/b&gt;&lt;br&gt;callers · shared contracts · per-tenant impact" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="890" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p6c21" value="&lt;b&gt;6a · Deploy notes&lt;/b&gt;&lt;br&gt;Fix version from the spec, else ask once;&lt;br&gt;unknown — to be confirmed if nobody knows" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="1000" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p6c23" value="deploy-notes.md (unbranded)" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="860" y="1020" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p6c25" value="&lt;b&gt;7 · reviewer sub-agent&lt;/b&gt; (haiku, read-only)&lt;br&gt;root cause, not a symptom · no regression&lt;br&gt;also reads deploy-notes.md (a new file)" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="1120" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p6c27" value="&lt;b&gt;BLOCKER?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="510" y="1240" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6c29" value="&lt;b&gt;Fix the BLOCKERs&lt;/b&gt;&lt;br&gt;then re-run the reviewer" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="860" y="1248" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p6c32" value="&lt;b&gt;7a · Runtime verification&lt;/b&gt; — page 8&lt;br&gt;first the original failure must now pass, then&lt;br&gt;the checks the blast radius flagged" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="1360" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p6c34" value="test-specs/e2e-report.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="860" y="1380" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p6c36" value="&lt;b&gt;FAIL or&lt;/b&gt;&lt;br&gt;&lt;b&gt;NOT RUN?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="500" y="1480" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p6c38" value="&lt;b&gt;STOP — blocks the commit&lt;/b&gt;&lt;br&gt;unless you accept each one" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="40" y="1485" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6c40" value="&lt;b&gt;Final gate run&lt;/b&gt; on the final code&lt;br&gt;shown to you with the review verdict" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="1610" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p6c42" value="test-specs/test-report.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="860" y="1624" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p6c44" value="&lt;b&gt;8 · Commit&lt;/b&gt; fix: … with the deploy notes, test report,&lt;br&gt;e2e report and .claude/agent-memory/" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="1720" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p6c46" value="Report: root cause · fix · verification · risks" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="400" y="1830" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6c48" value="&lt;b&gt;Fix causes, not symptoms&lt;/b&gt;&lt;br&gt;The smaller a fix looks, the less scrutiny it&lt;br&gt;gets, so the reviewer still runs, on one small diff." style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="1280" y="120" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p6c49" value="&lt;b&gt;Ratchet&lt;/b&gt;&lt;br&gt;legacy code the fix touches only has to not get&lt;br&gt;worse, so a fix never turns into a rewrite." style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="1280" y="204" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p6c50" value="&lt;b&gt;.ai/features/&amp;lt;slug&amp;gt;/&lt;/b&gt;&lt;br&gt;slug = the branch name minus fix/&lt;br&gt;deploy notes, test report and e2e report&lt;br&gt;No deploy impact still writes the file" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="1280" y="288" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6c51" value="&lt;b&gt;Hard rules&lt;/b&gt;&lt;br&gt;BLOCKER findings resolved before the commit&lt;br&gt;FAIL or NOT RUN blocks unless you accept it&lt;br&gt;never weaken a check to pass the gate" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p6c1">
          <mxGeometry x="1280" y="388" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p6c52" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start / end · blue = step in your session · yellow diamond = decision · red hexagon = STOP · purple = sub-agent · orange = file written · green = rule · red box = hard rule · dashed = writes a file" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p6c1">
          <mxGeometry x="40" y="1930" width="1620" height="20" as="geometry" />
