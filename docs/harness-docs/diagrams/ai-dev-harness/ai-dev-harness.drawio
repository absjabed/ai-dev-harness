        <mxCell id="p4c51" value="&lt;b&gt;5a · Document &amp;amp; deploy notes&lt;/b&gt;&lt;br&gt;update the docs it affects · Fix version from&lt;br&gt;requirement-spec.md · name the guide section,&lt;br&gt;or say No deploy impact" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p4c1">
