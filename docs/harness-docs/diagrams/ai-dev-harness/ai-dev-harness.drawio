        <mxCell id="p4c47" value="&lt;b&gt;reviewer&lt;/b&gt;&lt;br&gt;haiku · read-only&lt;br&gt;BLOCKER · WARNING ·&lt;br&gt;SUGGESTION · PRAISE&lt;br&gt;→ review-report.md" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p4c1">
