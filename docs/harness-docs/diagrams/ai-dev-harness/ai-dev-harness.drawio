  <diagram id="page8" name="8 Runtime Verification">
    <mxGraphModel dx="1700" dy="1660" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1660" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="p8c0" />
        <mxCell id="p8c1" parent="p8c0" />
        <mxCell id="p8c2" value="Runtime verification — API · UI · DB checks against a running system" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p8c3" value="Four workflows call &lt;b&gt;.ai/workflows/runtime-verification.md&lt;/b&gt;. It runs in &lt;b&gt;your session&lt;/b&gt;, not a sub-agent: the agent proposes checks from the change, asks once, runs them against the test environment and writes an e2e report. A FAIL or a planned check that did not run blocks the commit." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="40" y="60" width="1620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p8c4" value="&lt;b&gt;/workflows:feature&lt;/b&gt;&lt;br&gt;step 5b · epic Phase F 0a" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="50" y="120" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p8c5" value="&lt;b&gt;/workflows:bugfix&lt;/b&gt;&lt;br&gt;step 7a · the original bug first" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="330" y="120" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p8c6" value="&lt;b&gt;/workflows:hotfix&lt;/b&gt;&lt;br&gt;step 5a · smoke only" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="610" y="120" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p8c7" value="&lt;b&gt;/workflows:verify&lt;/b&gt;&lt;br&gt;on demand · ad-hoc work" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="890" y="120" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p8c8" value="Runs in this session — you confirm, log in, decide" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="400" y="234" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p8c13" value="&lt;b&gt;Test environments&lt;/b&gt;&lt;br&gt;filled in?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="480" y="330" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8c15" value="&lt;b&gt;STOP — values missing&lt;/b&gt;&lt;br&gt;say which ones; never&lt;br&gt;guess a URL" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="40" y="335" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p8c17" value="&lt;b&gt;1 · Plan&lt;/b&gt; from the diff + requirement-spec,&lt;br&gt;test-specs and deploy-notes: propose levels" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="400" y="470" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p8c19" value="&lt;b&gt;Levels&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f7f7f7;strokeColor=#bbbbbb;fontColor=#333333;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="230" y="580" width="740" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p8c21" value="&lt;b&gt;API&lt;/b&gt; — endpoints, contracts,&lt;br&gt;validation, auth, tenancy&lt;br&gt;happy path · 400 · 401 · 403&lt;br&gt;404 · 409 · response shape" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="250" y="630" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p8c22" value="&lt;b&gt;UI&lt;/b&gt; — pages, forms, routing,&lt;br&gt;client state, styling&lt;br&gt;test-specs journeys · states&lt;br&gt;console errors · failed calls" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="490" y="630" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p8c23" value="&lt;b&gt;DB&lt;/b&gt; — schema, migrations,&lt;br&gt;data access, tenant filters&lt;br&gt;rows written · tenant key set&lt;br&gt;migration recorded" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="730" y="630" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p8c24" value="&lt;b&gt;1 · STOP — ask once&lt;/b&gt;&lt;br&gt;run as proposed, or edit the plan&lt;br&gt;(no runtime surface: confirm too)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="380" y="780" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p8c26" value="&lt;b&gt;2 · Preflight&lt;/b&gt;&lt;br&gt;targets from Test environments only · health URL&lt;br&gt;(down → offer the start command) · a test token&lt;br&gt;from a token command or an env var set at launch" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="400" y="910" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p8c28" value="&lt;b&gt;3 · Run&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;fontColor=#333333;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="230" y="1040" width="740" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p8c30" value="&lt;b&gt;API&lt;/b&gt; — one curl per check&lt;br&gt;the token stays a variable&lt;br&gt;another tenant's record must&lt;br&gt;be refused: a leak is CRITICAL" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="250" y="1090" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p8c31" value="&lt;b&gt;UI&lt;/b&gt; — Claude in Chrome →&lt;br&gt;Playwright → e2e command&lt;br&gt;→ NOT RUN · new tab only&lt;br&gt;test account signed in?" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="490" y="1090" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p8c32" value="&lt;b&gt;DB&lt;/b&gt; — SELECT only, through&lt;br&gt;a read-only DB MCP server&lt;br&gt;none configured → NOT RUN&lt;br&gt;ids and counts only" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="730" y="1090" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p8c33" value="&lt;b&gt;4 · Report&lt;/b&gt; → e2e report, every check PASS,&lt;br&gt;FAIL or NOT RUN, on observed evidence only&lt;br&gt;clean up test data through the API" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="400" y="1240" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p8c35" value="&lt;b&gt;e2e report&lt;/b&gt;&lt;br&gt;test-specs/e2e-report.md, or&lt;br&gt;.ai/reports/e2e-&amp;lt;date&amp;gt;-&amp;lt;slug&amp;gt;.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="70" y="1248" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p8c37" value="&lt;b&gt;FAIL or a planned&lt;/b&gt;&lt;br&gt;&lt;b&gt;check NOT RUN?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="470" y="1360" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8c39" value="&lt;b&gt;Your call&lt;/b&gt;&lt;br&gt;fix the cause and re-run the failed&lt;br&gt;checks, or accept each one (STATE.md + PR)" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="860" y="1372" width="320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p8c42" value="Gate passes — the commit STOP shows the summary" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
          <mxGeometry x="400" y="1500" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p8c45" value="&lt;b&gt;Why in your session&lt;/b&gt;&lt;br&gt;you confirm the plan, do any login, approve the&lt;br&gt;browser's site prompts and decide on failures.&lt;br&gt;The qa-runner sub-agent declines this work." style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="1280" y="120" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p8c46" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;a production host, or one you are unsure of&lt;br&gt;print, store or commit a token or password&lt;br&gt;write to the database · use a real person's data&lt;br&gt;report a PASS you did not observe" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="1280" y="220" width="380" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p8c47" value="&lt;b&gt;e2e-guard.sh&lt;/b&gt; (PreToolUse)&lt;br&gt;blocks curl, wget, Invoke-WebRequest and the&lt;br&gt;browser tools for hosts in E2E_FORBIDDEN_HOSTS" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="1280" y="336" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p8c48" value="&lt;b&gt;Credentials&lt;/b&gt;&lt;br&gt;a token command inline, or an env var exported&lt;br&gt;before starting Claude Code · logins and&lt;br&gt;CAPTCHAs are yours · never type a password" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="1280" y="420" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p8c49" value="&lt;b&gt;Screenshots&lt;/b&gt;&lt;br&gt;test-specs/e2e-screenshots/ · git-ignored&lt;br&gt;local evidence, never committed" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1">
          <mxGeometry x="1280" y="520" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p8c50" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start / end · blue = step or command · yellow = decision · red hexagon = STOP · grey = guard · orange = file written · green = rule · red box = hard rule · dashed = writes a file" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p8c1">
