  <diagram id="page10" name="10 Guardrails">
    <mxGraphModel dx="1700" dy="1172" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1172" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="p10c0" />
        <mxCell id="p10c1" parent="p10c0" />
        <mxCell id="p10c2" value="Guardrails — nine hooks, one config" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p10c3" value='Each row is one hook: the &lt;b&gt;Claude Code event&lt;/b&gt; that fires it, the &lt;b&gt;script&lt;/b&gt; in .claude/hooks/, and its &lt;b&gt;effect&lt;/b&gt;. Every script sources &lt;b&gt;hooks.env&lt;/b&gt; and skips any check whose value is blank or "off", so the template blocks nothing until you opt in.' style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="60" width="1620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p10c4" value="Claude Code event" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="130" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p10c5" value="Hook script" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="440" y="130" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p10c6" value="Effect" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="700" y="130" width="580" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p10c7" value="&lt;b&gt;PreToolUse&lt;/b&gt;&lt;br&gt;Edit · Write · MultiEdit" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="170" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c8" value="&lt;b&gt;pre-tool-use.sh&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="400" y="170" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c9" value="&lt;b&gt;BLOCK&lt;/b&gt; an edit to a MIGRATIONS_GLOB file (run MIGRATIONS_REGEN_CMD instead)&lt;br&gt;and, with SUPPRESSION_CHECK=block, an edit that adds a suppression or skipped test&lt;br&gt;WARN on .env, production config, SENSITIVE_CONFIG_GLOBS · NOTE on hooks.env edits" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="700" y="170" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c12" value="&lt;b&gt;PreToolUse&lt;/b&gt;&lt;br&gt;Bash" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="258" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c13" value="&lt;b&gt;git-guard.sh&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="400" y="258" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c14" value="&lt;b&gt;BLOCK&lt;/b&gt; git push --force and git reset --hard (always on, no override)&lt;br&gt;· a push to PROTECTED_BRANCHES · DEPLOY_CMD aimed at PROD_STAGE&lt;br&gt;WARN on a push from a branch outside WORK_BRANCH_PREFIXES" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="700" y="258" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c17" value="&lt;b&gt;PreToolUse&lt;/b&gt;&lt;br&gt;Bash · PowerShell · browser MCP tools" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="346" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c18" value="&lt;b&gt;e2e-guard.sh&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="400" y="346" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c19" value="&lt;b&gt;BLOCK&lt;/b&gt; an HTTP client (curl, wget, httpie, xh, Invoke-WebRequest …) or a browser&lt;br&gt;tool call that names a host in E2E_FORBIDDEN_HOSTS: the agent never touches production" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="700" y="346" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c22" value="&lt;b&gt;PostToolUse&lt;/b&gt;&lt;br&gt;Edit · Write · MultiEdit" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="434" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c23" value="&lt;b&gt;post-tool-use.sh&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="400" y="434" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c24" value="&lt;b&gt;WARN&lt;/b&gt; type-check + lint of the edited package (TYPECHECK_CMD, LINT_CMD, PACKAGE_CMDS)&lt;br&gt;· tenant isolation · frontend env · design tokens · TDD nudge · suppressions (warn)&lt;br&gt;sent to Claude as additionalContext; never blocks" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="700" y="434" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c27" value="&lt;b&gt;PostToolBatch&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="522" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c28" value="&lt;b&gt;post-tool-batch.sh&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="400" y="522" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c29" value="&lt;b&gt;WARN&lt;/b&gt; full type-check of a PACKAGE_DIRS dir when 2+ of its files changed in one batch" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="700" y="522" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c32" value="&lt;b&gt;PostToolUseFailure&lt;/b&gt;&lt;br&gt;Edit · Write · Bash" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="610" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c33" value="&lt;b&gt;post-tool-failure.sh&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="400" y="610" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c34" value="&lt;b&gt;HINT&lt;/b&gt; classifies the failure (type error, lint, migration, missing module)&lt;br&gt;and passes Claude a fix hint; never blocks" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="700" y="610" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c37" value="&lt;b&gt;Stop&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="698" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c38" value="&lt;b&gt;stop-check.sh&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="400" y="698" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c39" value="&lt;b&gt;REMIND&lt;/b&gt; uncommitted tracked changes on a work branch (WORK_BRANCH_PREFIXES,&lt;br&gt;default feature/ and epic/) → a systemMessage shown to you" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="700" y="698" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c42" value="&lt;b&gt;UserPromptSubmit&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="786" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c43" value="&lt;b&gt;user-prompt-context.sh&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="400" y="786" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c44" value="&lt;b&gt;CONTEXT&lt;/b&gt; adds one line before each prompt: [Context] Branch: … | scope" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="700" y="786" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c47" value="&lt;b&gt;SessionStart&lt;/b&gt;&lt;br&gt;matcher: compact" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="874" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c48" value="&lt;b&gt;compact-restore.sh&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="400" y="874" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c49" value="&lt;b&gt;CONTEXT&lt;/b&gt; after compaction: branch, scope, in-progress feature or epic,&lt;br&gt;STATE.md current phase and next action, the last 5 commits" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="700" y="874" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p10c52" value='&lt;b&gt;.claude/hooks/hooks.env&lt;/b&gt; — template defaults&lt;br&gt;blank or "off" = check skipped&lt;br&gt;PROTECTED_BRANCHES=""&lt;br&gt;WORK_BRANCH_PREFIXES=""&lt;br&gt;VCS_CLI="git" · PR_TERM="pull request"&lt;br&gt;DEPLOY_CMD="" · PROD_STAGE=""&lt;br&gt;PACKAGE_DIRS, BACKEND_DIR, FRONTEND_DIR=""&lt;br&gt;TYPECHECK_CMD, LINT_CMD, PACKAGE_CMDS=""&lt;br&gt;MIGRATIONS_GLOB, SENSITIVE_CONFIG_GLOBS=""&lt;br&gt;TENANT_ISOLATION_CHECK="off"&lt;br&gt;FRONTEND_ENV_CHECK="off"&lt;br&gt;DESIGN_TOKEN_CHECK="off" · TDD_CHECK="off"&lt;br&gt;SUPPRESSION_CHECK="off"&lt;br&gt;gate: GATE_BUILD_CMD, GATE_TEST_CMD,&lt;br&gt;COVERAGE_MIN, COMPLEXITY_MAX, CRAP_MAX,&lt;br&gt;MUTATION_CMD="" (SOURCE_GLOBS preset)&lt;br&gt;E2E_FORBIDDEN_HOSTS=""' style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="1300" y="170" width="360" height="280" as="geometry" />
        </mxCell>
        <mxCell id="p10c54" value="&lt;b&gt;Exit codes&lt;/b&gt;&lt;br&gt;exit 2 → blocked; Claude reads the stderr&lt;br&gt;exit 0 + additionalContext JSON → a&lt;br&gt;warning Claude sees (stderr alone reaches&lt;br&gt;nobody) · Stop → systemMessage to you" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="1300" y="470" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p10c55" value="&lt;b&gt;.claude/settings.json&lt;/b&gt;&lt;br&gt;registers each script on its event and&lt;br&gt;matcher; hooks need bash on PATH" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="1300" y="580" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p10c56" value="&lt;b&gt;Guardrails beyond hooks&lt;/b&gt;&lt;br&gt;quality-gate.sh at every verify step: a FAIL stops the workflow, and the base commit's hooks.env keeps the stricter limits&lt;br&gt;least privilege: reviewer and critic have no Write or Edit tool; /agents:review, /agents:security, /harness:ask, /utils:status and /utils:docs-serve disallow writes&lt;br&gt;/agents:devops is advise-only by default: devops-mode.sh on | off | status rewrites its allowed-tools, and every command still needs your approval&lt;br&gt;STOP gates in every workflow · outward writes (tracker updates, PRs) are shown and confirmed first · MCP tools granted per command; .mcp.json holds no secrets&lt;br&gt;runtime verification never targets production, never writes to the database and never prints a token" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="982" width="1240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p10c57" value="&lt;i&gt;Legend:&lt;/i&gt; grey = Claude Code event · blue = hook script, HINT or CONTEXT · red = BLOCK (exit 2) · yellow = WARN or REMIND · green = config · dashed = sourced by" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p10c1">
          <mxGeometry x="40" y="1122" width="1620" height="20" as="geometry" />
        </mxCell>
