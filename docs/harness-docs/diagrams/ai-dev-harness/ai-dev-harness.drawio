          <mxGeometry x="740" y="926" width="400" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p2c67" value="&lt;b&gt;harness-guide-agent.md&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p2c1">
          <mxGeometry x="420" y="980" width="260" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p2c68" value="&lt;b&gt;/harness:ask&lt;/b&gt;&lt;br&gt;read-only Q&amp;amp;A" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p2c1">
          <mxGeometry x="40" y="980" width="320" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p2c70" value="&lt;b&gt;Who spawns sub-agents&lt;/b&gt;&lt;br&gt;/workflows:feature → developer, reviewer,&lt;br&gt;security-scanner&lt;br&gt;/workflows:bugfix, /workflows:hotfix → reviewer&lt;br&gt;/workflows:release → security-scanner,&lt;br&gt;release-manager&lt;br&gt;/harness:improve → harness-engineer, critic&lt;br&gt;orchestrator → developer, reviewer,&lt;br&gt;security-scanner, qa-runner" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p2c1">
          <mxGeometry x="1220" y="170" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2c71" value="&lt;b&gt;Command vs sub-agent&lt;/b&gt;&lt;br&gt;A command runs in your session, so it can stop&lt;br&gt;at a gate and ask you. A sub-agent starts in a fresh&lt;br&gt;context with its own tool list, does one job and&lt;br&gt;returns a report. Gates stay with the command." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p2c1">
          <mxGeometry x="1220" y="340" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2c72" value="&lt;b&gt;Defer to the persona&lt;/b&gt; (invariant 2)&lt;br&gt;Behaviour is written once, in .ai/agents/.&lt;br&gt;Commands and sub-agents add scope loading, tools&lt;br&gt;and the task. They never repeat its rules." style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p2c1">
          <mxGeometry x="1220" y="450" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2c73" value="&lt;b&gt;Scope first&lt;/b&gt;&lt;br&gt;Most commands and sub-agents read current-scope.md,&lt;br&gt;pick backend, frontend or fullstack, and load only&lt;br&gt;that scope's config, context and standards." style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p2c1">
          <mxGeometry x="1220" y="550" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2c74" value="&lt;b&gt;Read-only by grant&lt;/b&gt;&lt;br&gt;reviewer and critic have no Write or Edit tool.&lt;br&gt;/agents:review, /agents:security, /harness:ask,&lt;br&gt;/utils:status and /utils:docs-serve disallow&lt;br&gt;Write, Edit, MultiEdit and NotebookEdit." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p2c1">
          <mxGeometry x="1220" y="650" width="380" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p2c75" value="&lt;i&gt;Legend:&lt;/i&gt; blue = command · green = persona and rules · purple = sub-agent (fresh context) · red = read-only rule · solid = @include · dashed = loads (the sub-agent's own @include)" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p2c1">
          <mxGeometry x="40" y="1050" width="1620" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p2c9" value="@include" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p2c1" source="p2c8" target="p2c7">
