        <mxCell id="p11c34" value="&lt;b&gt;6 · Integration audit&lt;/b&gt; — one critic, the whole change&lt;br&gt;file ownership · cross-file contracts · mirror invariant&lt;br&gt;bash -n · broken references · doc inventories + counts" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p11c1">
