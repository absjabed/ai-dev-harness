        <mxCell id="p4c19" value="&lt;b&gt;1 · Technical spec&lt;/b&gt;&lt;br&gt;backend.md + frontend.md when fullstack" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p4c1">
