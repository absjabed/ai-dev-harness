        </mxCell>
        <mxCell id="p11c45" value="&lt;b&gt;Invariants — the critic's checklist&lt;/b&gt;&lt;br&gt;breaking one is a CRITICAL defect&lt;br&gt;1 · Two-layer split (.ai/ knows, .claude/ runs)&lt;br&gt;2 · Three-layer agent pattern&lt;br&gt;3 · Template genericness&lt;br&gt;4 · Inert-safety of every hook check&lt;br&gt;5 · Gate integrity: never weaken a gate&lt;br&gt;6 · Mirror invariant (while examples/ exists)&lt;br&gt;7 · Docs inventories stay true&lt;br&gt;8 · Tool least-privilege&lt;br&gt;&lt;b&gt;Integration rules&lt;/b&gt;&lt;br&gt;9 · No secrets in config&lt;br&gt;10 · Per-command MCP grants&lt;br&gt;11 · Outward writes sit behind gates&lt;br&gt;12 · Optional by default&lt;br&gt;13 · Agents never authenticate" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p11c1">
          <mxGeometry x="1280" y="120" width="380" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p11c46" value="&lt;b&gt;/harness:ask &amp;lt;question&amp;gt;&lt;/b&gt;&lt;br&gt;read-only Q&amp;amp;A (harness-guide-agent): answers&lt;br&gt;from the repo's own files, cites paths, sends&lt;br&gt;product questions to the right command" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p11c1">
          <mxGeometry x="1280" y="400" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p11c47" value="&lt;b&gt;Hard rules&lt;/b&gt;&lt;br&gt;only verified defects count as findings&lt;br&gt;shell changes run for real, not just critiqued&lt;br&gt;never commit on the default branch" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p11c1">
          <mxGeometry x="1280" y="500" width="380" height="76" as="geometry" />
        </mxCell>
