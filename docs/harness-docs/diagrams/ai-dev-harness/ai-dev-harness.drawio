  <diagram id="page9" name="9 Release">
    <mxGraphModel dx="1700" dy="1750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1750" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="p9c0" />
        <mxCell id="p9c1" parent="p9c0" />
        <mxCell id="p9c2" value="Release — /workflows:release &amp;lt;version&amp;gt;" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p9c3" value="The security scan and the release artifacts run &lt;b&gt;in parallel&lt;/b&gt;, fed by every &lt;b&gt;deploy-notes.md&lt;/b&gt; whose fix version matches. Nothing is bumped, tagged or written under docs/release/ until you confirm at the &lt;b&gt;STOP&lt;/b&gt;. The deployment guide is optional." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="40" y="60" width="1620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p9c4" value="/workflows:release &amp;lt;version&amp;gt;" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="440" y="120" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p9c5" value="&lt;b&gt;1 · Security gate ∥ release artifacts&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="400" y="210" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p9c7" value="&lt;b&gt;∥ parallel&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f7f2fa;strokeColor=#9673a6;fontColor=#333333;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="320" y="304" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p9c8" value="&lt;b&gt;security-scanner&lt;/b&gt;&lt;br&gt;git diff &amp;lt;last tag&amp;gt;..HEAD&lt;br&gt;+ dependency audit&lt;br&gt;CRITICAL · HIGH · …&lt;br&gt;→ security-report.md" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1">
          <mxGeometry x="340" y="354" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p9c10" value="&lt;b&gt;release-manager&lt;/b&gt; · sonnet&lt;br&gt;commits since the last tag&lt;br&gt;migrations · deploy notes&lt;br&gt;→ release-notes · migration-plan&lt;br&gt;rollback-plan · checklist" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1">
          <mxGeometry x="610" y="354" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p9c12" value="&lt;b&gt;.ai/features/**/deploy-notes.md&lt;/b&gt;&lt;br&gt;from feature · bugfix · hotfix&lt;br&gt;selected by fix version" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1">
          <mxGeometry x="960" y="372" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p9c14" value=".ai/releases/&amp;lt;version&amp;gt;/" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="960" y="444" width="260" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p9c16" value="Evaluate the security results" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="400" y="514" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p9c19" value="&lt;b&gt;CRITICAL&lt;/b&gt;&lt;br&gt;&lt;b&gt;findings?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="500" y="610" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p9c21" value="&lt;b&gt;STOP — resolve CRITICAL&lt;/b&gt;&lt;br&gt;findings before going on" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="40" y="615" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p9c23" value="&lt;b&gt;2 · Quality gates&lt;/b&gt; per changed sub-project&lt;br&gt;its lint, test and build commands" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1">
          <mxGeometry x="400" y="740" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p9c25" value="&lt;b&gt;3 · STOP — confirm the release&lt;/b&gt;&lt;br&gt;security verdict · artifact paths&lt;br&gt;deploy notes · gate results&lt;br&gt;what step 4 does with the guide" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="380" y="850" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p9c27" value="&lt;b&gt;4 · Finalize&lt;/b&gt;&lt;br&gt;bump each manifest (fix → patch, feat → minor,&lt;br&gt;BREAKING → major) · CHANGELOG.md (Keep a Changelog)" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1">
          <mxGeometry x="400" y="990" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p9c29" value="&lt;b&gt;deployment guide&lt;/b&gt;&lt;br&gt;&lt;b&gt;switched on?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="480" y="1110" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p9c31" value="&lt;b&gt;4 · Deployment guide&lt;/b&gt;&lt;br&gt;create or merge docs/release/&amp;lt;version&amp;gt;/&lt;br&gt;deployment-guide-&amp;lt;version&amp;gt;.md&lt;br&gt;md-to-docx.py if the Word copy is on&lt;br&gt;refresh docs/release/README.md" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1">
          <mxGeometry x="860" y="1110" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p9c33" value="&lt;b&gt;5 · Commit&lt;/b&gt; chore(release): bump version to &amp;lt;version&amp;gt;&lt;br&gt;with the guide .md + .docx and .claude/agent-memory/" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1">
          <mxGeometry x="400" y="1250" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p9c36" value="&lt;b&gt;6 · Tag&lt;/b&gt; — git tag &amp;lt;version&amp;gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="400" y="1360" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p9c38" value="&lt;b&gt;issue tracker&lt;/b&gt;&lt;br&gt;&lt;b&gt;connected?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="490" y="1460" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p9c40" value="&lt;b&gt;7 · STOP — tracker update&lt;/b&gt;&lt;br&gt;show issues, transition and&lt;br&gt;comment; apply on yes" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="860" y="1460" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p9c42" value="Done — no push, no deploy" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
          <mxGeometry x="440" y="1590" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p9c45" value="&lt;b&gt;Guide only after the STOP&lt;/b&gt;&lt;br&gt;an agent asked only for the internal artifacts&lt;br&gt;stops there and writes nothing under docs/release/" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1">
          <mxGeometry x="1280" y="120" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p9c46" value="&lt;b&gt;Merge, never clobber&lt;/b&gt;&lt;br&gt;an existing guide is merged; if it cannot merge&lt;br&gt;cleanly → STOP. The .md is the source of truth;&lt;br&gt;the .docx is never hand-edited." style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1">
          <mxGeometry x="1280" y="204" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p9c47" value="&lt;b&gt;Step 2 checks&lt;/b&gt;&lt;br&gt;each changed sub-project's lint, test and build&lt;br&gt;commands from its project-config" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1">
          <mxGeometry x="1280" y="304" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p9c48" value="&lt;b&gt;Hard rules&lt;/b&gt;&lt;br&gt;CRITICAL findings block the release&lt;br&gt;HIGH findings: you decide whether to go on&lt;br&gt;no push and no deploy: that is DevOps work" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1">
          <mxGeometry x="1280" y="388" width="380" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p9c49" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start / end · blue = step in your session · yellow diamond = decision · red hexagon = STOP · purple = sub-agent · orange = file written · green = rule · red box = hard rule · dashed = writes a file" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p9c1">
