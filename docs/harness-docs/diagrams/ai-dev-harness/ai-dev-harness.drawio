        <mxCell id="p3c47" value='&lt;b&gt;/workflows:bugfix "&amp;lt;symptom&amp;gt;"&lt;/b&gt;&lt;br&gt;reproduce → root cause → fix →&lt;br&gt;review → runtime checks → commit&lt;br&gt;writes deploy-notes.md' style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p3c1">
