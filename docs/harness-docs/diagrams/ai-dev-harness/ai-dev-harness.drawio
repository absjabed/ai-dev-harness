        <mxCell id="p4c31" value="&lt;b&gt;3 · Create branch&lt;/b&gt; feature/&amp;lt;slug&amp;gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p4c1">
          <mxGeometry x="400" y="1235" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p4c34" value="&lt;b&gt;4 · developer sub-agent (fresh context)&lt;/b&gt;&lt;br&gt;works through ## Tasks in STATE.md, writes tests&lt;br&gt;quality-gate.sh --base &amp;lt;base&amp;gt;: ≤ 3 failing runs,&lt;br&gt;--mutation on the last run" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p4c1">
          <mxGeometry x="400" y="1330" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4c36" value="test-specs/test-report.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p4c1">
          <mxGeometry x="860" y="1357" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p4c38" value="&lt;b&gt;4 · Re-run quality-gate.sh in this session&lt;/b&gt;&lt;br&gt;no --mutation · this run replaces ## Quality gate" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p4c1">
