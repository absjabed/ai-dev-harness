        <mxCell id="p4c29" value="&lt;b&gt;STOP — approve design&lt;/b&gt;&lt;br&gt;you approve the Artifact;&lt;br&gt;the Architect approves too&lt;br&gt;→ design/design-spec.md" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p4c1">
          <mxGeometry x="860" y="1125" width="320" height="100" as="geometry" />
