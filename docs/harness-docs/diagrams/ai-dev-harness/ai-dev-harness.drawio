  <diagram id="page7" name="7 Hotfix">
    <mxGraphModel dx="1700" dy="1960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1960" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="p7c0" />
        <mxCell id="p7c1" parent="p7c0" />
        <mxCell id="p7c2" value="Hotfix — /workflows:hotfix" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p7c3" value="An urgent production fix: &lt;b&gt;fast, minimal, safe&lt;/b&gt;. It branches from the default branch, still gets deploy notes, a &lt;b&gt;reviewer&lt;/b&gt; and a smoke check, and lands through a PR. Yellow steps after landing are done by people or CI, never by the agent." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="40" y="60" width="1620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p7c4" value='/workflows:hotfix "&amp;lt;issue&amp;gt;"' style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="440" y="120" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p7c5" value="&lt;b&gt;1 · Branch from the default branch&lt;/b&gt; (production)&lt;br&gt;fix/ or hotfix/ + ticket + slug, never from a feature" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="400" y="210" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7c7" value="&lt;b&gt;2 · Minimal change only&lt;/b&gt; — no refactors, no cleanup" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="400" y="320" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p7c9" value="&lt;b&gt;3 · Guard the fix&lt;/b&gt;&lt;br&gt;failing test, or a manual reproduction" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="400" y="420" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7c11" value="&lt;b&gt;4 · Verify&lt;/b&gt;&lt;br&gt;quality-gate.sh --base &amp;lt;default branch&amp;gt;, once,&lt;br&gt;no --mutation · output goes in the PR&lt;br&gt;a FAIL is fixed, or a person accepts it" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="400" y="530" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p7c13" value="&lt;b&gt;4a · Deploy notes&lt;/b&gt;&lt;br&gt;committed with the fix, before the review" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="400" y="650" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7c15" value="deploy-notes.md (unbranded)" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="860" y="664" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p7c17" value="&lt;b&gt;5 · reviewer sub-agent&lt;/b&gt; on git diff &amp;lt;default&amp;gt;...HEAD&lt;br&gt;minimal · reversible · root cause · no unrelated edits" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="400" y="760" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7c19" value="&lt;b&gt;BLOCKER?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="510" y="870" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p7c21" value="&lt;b&gt;Resolve the BLOCKERs&lt;/b&gt;&lt;br&gt;before the PR is opened" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="860" y="878" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7c24" value="&lt;b&gt;5a · STOP — confirm smoke plan&lt;/b&gt;&lt;br&gt;one line: the broken journey or&lt;br&gt;request, non-production only" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="380" y="990" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p7c26" value="&lt;b&gt;5a · Smoke check&lt;/b&gt; — page 8&lt;br&gt;one level, a handful of checks" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="400" y="1120" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7c28" value="test-specs/e2e-report.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="860" y="1134" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p7c30" value="&lt;b&gt;FAIL or&lt;/b&gt;&lt;br&gt;&lt;b&gt;NOT RUN?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="500" y="1230" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p7c32" value="&lt;b&gt;STOP — blocks step 6&lt;/b&gt;&lt;br&gt;unless you accept it" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="40" y="1235" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p7c34" value="&lt;b&gt;Gate again&lt;/b&gt; if review or smoke fixes changed code" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="400" y="1360" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p7c36" value="&lt;b&gt;6 · Land it&lt;/b&gt;&lt;br&gt;commit .claude/agent-memory/ · open a PR into the&lt;br&gt;default branch · forward-port to dev and release/*" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="400" y="1460" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p7c38" value="&lt;b&gt;7 · Deploy with monitoring&lt;/b&gt; — a human or CI&lt;br&gt;follow deploy-notes.md · watch logs and metrics" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="400" y="1580" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7c40" value="&lt;b&gt;8 · Post-mortem within 48 hours&lt;/b&gt;&lt;br&gt;root cause · why it was missed · prevention" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="400" y="1690" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7c42" value="Done" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="440" y="1800" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p7c44" value="&lt;b&gt;Skipping is never silent&lt;/b&gt;&lt;br&gt;Review: only for a one-line revert in a live&lt;br&gt;outage, with a human's approval recorded in the PR.&lt;br&gt;Smoke check: only with your explicit approval." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="1280" y="120" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p7c45" value="&lt;b&gt;Production is never a target&lt;/b&gt;&lt;br&gt;e2e-guard.sh blocks hosts in E2E_FORBIDDEN_HOSTS;&lt;br&gt;git-guard.sh blocks pushes to protected branches" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="1280" y="220" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7c46" value="&lt;b&gt;Fast, minimal, safe&lt;/b&gt;&lt;br&gt;smallest reversible change wins · no --mutation&lt;br&gt;(too slow for an incident) · the ratchet applies" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="1280" y="304" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7c47" value="&lt;b&gt;.ai/features/&amp;lt;slug&amp;gt;/&lt;/b&gt;&lt;br&gt;slug = the branch name minus fix/ or hotfix/&lt;br&gt;never a version-based path" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1">
          <mxGeometry x="1280" y="388" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p7c48" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start / end · blue = step in your session · yellow diamond = decision · red hexagon = STOP · purple = sub-agent · orange = file written · yellow box = people or CI · green = rule · red box = hard rule · dashed = writes a file" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p7c1">
          <mxGeometry x="40" y="1900" width="1620" height="20" as="geometry" />
