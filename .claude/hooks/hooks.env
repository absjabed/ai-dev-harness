# hooks.env — project-specific values sourced by every .claude/hooks/*.sh script.
#
# HOW THIS WORKS: each hook sources this file and SKIPS a check when its value is
# empty (or its *_CHECK flag is "off"). An un-customized template is therefore
# inert-safe — no hook blocks or warns until you opt in here.
#
# Fill this in by running /init, or by hand. Leave anything you don't want blank.
# Values are space-separated lists where noted. All shell-quoted.

# ── Version control ──────────────────────────────────────────────────────────
# Branches that may never be pushed to directly (space-separated). e.g. "main develop"
PROTECTED_BRANCHES=""
# Allowed prefixes for working branches (space-separated, no slashes). e.g. "feature fix hotfix chore epic"
WORK_BRANCH_PREFIXES=""
# Your VCS CLI and the word your provider uses for a change request.
VCS_CLI="git"                    # git | gh | glab
PR_TERM="pull request"           # "pull request" (GitHub/Bitbucket) | "merge request" (GitLab)

# ── Deploy guard (optional) ──────────────────────────────────────────────────
# The deploy command to guard, if any. e.g. "serverless deploy" | "cdk deploy" | "terraform apply"
DEPLOY_CMD=""
# The production stage/environment name that must NEVER be deployed to directly. e.g. "prod"
PROD_STAGE=""

# ── Repo layout ──────────────────────────────────────────────────────────────
# Sub-project directories, space-separated. Single-project repos can leave blank or use "."
# e.g. "backend frontend"
PACKAGE_DIRS=""
# Optional named dirs used only by the domain checks below. e.g. BACKEND_DIR="backend"
BACKEND_DIR=""
FRONTEND_DIR=""

# ── Quality commands (run after edits; blank ⇒ skip) ─────────────────────────
# Type-check command run inside a changed sub-project. e.g. "npx tsc --noEmit" | "mypy ." | "go vet ./..."
TYPECHECK_CMD=""
# Lint command; receives the file path(s) as its last args (one after an edit, all changed files
# in the quality gate). Turn on its complexity rule too. e.g. "npx eslint" | "ruff check" | "golangci-lint run"
LINT_CMD=""

# ── Sensitive-file guards (blank ⇒ off) ──────────────────────────────────────
# Glob of generated files that must not be hand-edited (e.g. generated DB migrations).
MIGRATIONS_GLOB=""               # e.g. "*/db/migrations/*.sql"
MIGRATIONS_REGEN_CMD=""          # what to run instead. e.g. "npm run db:generate"
# Extra globs to WARN on before editing (space-separated). e.g. "*/serverless.yml */cdk.json"
SENSITIVE_CONFIG_GLOBS=""

# ── Optional domain checks (off by default) ──────────────────────────────────
# Multi-tenant isolation: warn when new DB queries in $BACKEND_DIR omit the tenant key.
TENANT_ISOLATION_CHECK="off"     # on | off
TENANT_KEY=""                    # e.g. "customerId" | "tenant_id"

# Frontend env access: warn when the wrong env accessor appears in $FRONTEND_DIR.
FRONTEND_ENV_CHECK="off"         # on | off
FRONTEND_ENV_BAD_PATTERN=""      # regex that should NOT appear. e.g. "process\\.env\\." for Vite apps
FRONTEND_ENV_GOOD_HINT=""        # what to use instead. e.g. "import.meta.env.VITE_*"

# Design tokens: warn on raw hex colors introduced in $FRONTEND_DIR (closed-palette rule).
DESIGN_TOKEN_CHECK="off"         # on | off
DESIGN_TOKEN_DOC=""              # doc to cite. e.g. ".ai/standards/project/frontend/design/palette.md"
DESIGN_TOKEN_EXEMPT_GLOBS=""     # token-source files exempt from the check. e.g. "*tailwind.config.* *globals.css"

# ── TDD nudge (off by default) ───────────────────────────────────────────────
# Warn when a source edit lands with no test change anywhere in the working tree.
TDD_CHECK="off"                  # on | off
TEST_FILE_PATTERNS=""            # space-separated globs identifying test files. e.g. "*.test.* *.spec.* *_test.*"
TDD_EXEMPT_GLOBS=""              # globs never nudged. e.g. "*.md *.json *.yml *.yaml *.config.*"

# ── Quality gate (blank ⇒ that check is skipped) ─────────────────────────────
# .claude/scripts/quality-gate.sh runs these at the workflows' verify steps and prints one
# PASS/FAIL with the numbers, so "the tests pass" is measured, not claimed. It judges only what
# the change touched. It also runs TYPECHECK_CMD and LINT_CMD, and uses TEST_FILE_PATTERNS
# (above) to tell test files from source. Nothing set ⇒ the gate reports NOT CONFIGURED.
GATE_BUILD_CMD=""                # run from the repo root. e.g. "npm run build" | "dotnet build -warnaserror"
GATE_TEST_CMD=""                 # run from the repo root; should also write the coverage report(s).
                                 # e.g. "npx vitest run --coverage" | "dotnet test --collect:'XPlat Code Coverage'"
# What counts as source code, for the gate and the suppression guard (blank ⇒ every file).
# Trim it to your stack. Test files are the ones that also match TEST_FILE_PATTERNS.
SOURCE_GLOBS="*.ts *.tsx *.js *.jsx *.mjs *.cjs *.vue *.svelte *.py *.cs *.java *.kt *.go *.rb *.php *.rs *.swift *.scala *.c *.cc *.cpp *.h *.hpp"
COVERAGE_REPORTS=""              # report path globs from the repo root (** recurses): lcov, Cobertura,
                                 # JaCoCo or Go profile. When the gate runs the tests, only reports that
                                 # run wrote count. e.g. "web/coverage/lcov.info api/TestResults/**/*.cobertura.xml"
COVERAGE_MIN=""                  # minimum % of the CHANGED lines the tests must run. e.g. "80"
# Source files tests cannot reach (entry points, generated code). With a limit set, a changed file
# that no report mentions otherwise counts as untested. e.g. "*/Program.cs */migrations/*"
COVERAGE_EXEMPT_GLOBS=""
# Complexity and CRAP need python 3 and `pip install lizard`. Both are per touched function, with
# a ratchet: a function that was already over the limit and did not get worse only warns.
COMPLEXITY_MAX=""                # max cyclomatic complexity per function. e.g. "15"
CRAP_MAX=""                      # max CRAP score (complexity² × (1 − coverage)³ + complexity). e.g. "30"
# Mutation testing, run only with --mutation (feature and epic flows): {files} = the changed
# source files, comma-separated; {base} = the commit the change is measured from;
# {each:TEMPLATE} = TEMPLATE once per changed source file, with {file} (its path) and {name} (its
# file name). The command's own threshold decides pass/fail; the result is kept for that exact
# change, so a later gate run on unchanged code reports it without running it again. Mutate only
# the changed files, or untested old code drags the score down. e.g.
# "npx stryker run --mutate {files} --thresholds.break 70" | "mutmut run --paths-to-mutate {files}"
# | "dotnet stryker {each:-m **/{name}} --break-at 70" (Stryker.NET's -m is relative to the
# project, hence {name}; its --since:{base} is no substitute: any changed non-C# file, such as a
# workflow's own .ai/ docs, makes it test every mutant)
MUTATION_CMD=""

# ── Suppression guard (off by default) ───────────────────────────────────────
# Catches the shortcut an agent takes under a failing gate: silencing the linter, excluding code
# from coverage, or skipping a test. "warn" tells Claude after the edit and lists each one in the
# gate output; "block" stops the edit (a human can still add one). Pair it with
# SENSITIVE_CONFIG_GLOBS above for the lint/coverage/mutation config files themselves.
SUPPRESSION_CHECK="off"          # off | warn | block
# Extended regex matched against added lines. Trim or extend for your stack.
SUPPRESSION_PATTERNS='eslint-disable|@ts-(ignore|nocheck|expect-error)|# *noqa|# *type: *ignore|pragma: *no cover|(istanbul|c8|v8) ignore|ExcludeFromCodeCoverage|#pragma warning disable|SuppressMessage|@SuppressWarnings|//nolint|NOSONAR|rubocop:disable|\b(it|test|describe)\.(skip|only)\(|\bx(it|describe)\(|pytest\.mark\.skip|\[Ignore\]|Skip *= *"|@Disabled|\bt\.Skip\('

# ── Runtime verification guard (blank ⇒ off) ─────────────────────────────────
# Hosts that API calls (curl/wget/Invoke-WebRequest…) and browser tools (Claude in Chrome,
# Playwright) must never reach — your production hosts. Matched as case-insensitive substrings.
E2E_FORBIDDEN_HOSTS=""             # e.g. "prod.example.com api.example.com" — host substrings, space-separated
